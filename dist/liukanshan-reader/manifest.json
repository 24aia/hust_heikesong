{
  "manifest_version": 3,
  "name": "刘看山长文续读助手",
  "version": "0.1.0",
  "description": "在本地记住知乎长文停留位置，并在确认后恢复。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "刘看山长文续读助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhihu.com/question/*/answer/*",
        "https://zhuanlan.zhihu.com/p/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/mascot.svg"
      ],
      "matches": [
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ]
    }
  ]
}
