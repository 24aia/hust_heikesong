{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liukanshan.local/schemas/recap-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inputHash", "mode", "summaryVersion", "items", "bridge", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mode": { "enum": ["brief", "bridge"] },
    "summaryVersion": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/evidenceArray" }
        }
      }
    },
    "bridge": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "evidence"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "#/$defs/evidenceArray" }
          }
        }
      ]
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "evidenceArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paragraphId", "quote"],
        "properties": {
          "paragraphId": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
