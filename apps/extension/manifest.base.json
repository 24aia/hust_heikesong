{
  "manifest_version": 3,
  "name": "刘看山长文续读助手",
  "version": "0.1.0",
  "description": "在本地记录知乎长文阅读位置，并按用户操作将断点前正文发送至知乎直答生成回顾。",
  "browser_specific_settings": {
    "gecko": {
      "id": "liukanshan-reader@24aia.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://developer.zhihu.com/*"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "刘看山长文续读助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhihu.com/question/*/answer/*",
        "https://zhuanlan.zhihu.com/p/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/mascot.png"],
      "matches": ["https://www.zhihu.com/*", "https://zhuanlan.zhihu.com/*"]
    }
  ]
}
